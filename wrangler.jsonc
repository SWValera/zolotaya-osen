{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zolotaya-osen",
  "main": "src/worker.js",
  "workers_dev": true,
  "compatibility_date": "2026-10-24",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
  },
  "kv_namespaces": [
    {
      "binding": "SITE_DATA",
      "id": "0279c61e980247e78b895c5601b32b69",
    },
  ],
}
